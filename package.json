{
	"name": "4dhower",
	"version": "0.1.0",
	"description": "Obsidian plugin for an eisenhower matrix style todo list system",
	"main": "main.js",
	"type": "commonjs",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
